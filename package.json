{
  "name": "stuorg-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && prisma generate --schema src/infrastructure/prisma/schema.prisma && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "format": "prettier --write --no-error-on-unmatched-pattern \"{src,tests,mocks}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,css,scss,less,html,vue,svelte,graphql,gql}\" \"*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"{src,tests,mocks}/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,css,scss,less,html,vue,svelte,graphql,gql}\" \"*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "npm run lint:fix && npm run format",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test -- --runInBand --watchman=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^6.16.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
