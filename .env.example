NODE_ENV=development
PORT=5001
CORS_ORIGINS=http://localhost:3000
# Optional during the bootstrap phase. Use the Supabase transaction pooler at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=3&pool_timeout=3&socket_timeout=3&sslmode=require
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SERVICE_ROLE_KEY
